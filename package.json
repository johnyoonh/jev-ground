{
  "name": "jev-ground",
  "version": "0.1.0",
  "description": "Evidence-grounded factuality verification for LLM and agent outputs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "benchmark": "npm run build && node dist/benchmark/cli.js"
  },
  "keywords": [
    "jev",
    "typesafe",
    "hallucination",
    "factuality",
    "rag",
    "verification",
    "benchmark"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
